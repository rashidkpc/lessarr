[Unit]
Description=lessarr media re-encoder
After=network-online.target remote-fs.target
Wants=network-online.target
# The media share is a prerequisite, not an optional extra: starting with an
# empty /media would look like an empty library.
RequiresMountsFor=/media

[Service]
Type=simple
ExecStart=/usr/local/bin/lessarr run --config /config/config.toml
Restart=on-failure
RestartSec=5
# The render node is root:root 0660 on this container host. The daemon also writes the
# SQLite database under /var/lib and replaces files on the share.
User=root
Nice=15
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
